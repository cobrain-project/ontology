                              owl:onProperty :materialNickname ;
                              owl:hasValue "Cantor"
                            ] ;
        rdfs:subClassOf :HighEntropyAlloy ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :atComposition ;
                          owl:hasValue "Co20Cr20Fe20Mn20Ni20"
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :elements ;
                          owl:hasValue "CoCrFeMnNi"
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :volComposition ;
                          owl:hasValue "CoCrFeMnNi100"
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :wtComposition ;
                          owl:hasValue "Co21Cr18.5Fe19.9Mn19.6Ni20.9"
                        ] ;
        <http://purl.org/dc/terms/source> "Literature"@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Cantor"@en ;
        :elucidation "The equiatomic CoCrFeMnNi high entropy alloy (Co20Cr20Fe20Mn20Ni20 at.%), named after B. Cantor, who first reported it in 2004."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CerMet
:CerMet rdf:type owl:Class ;
        rdfs:subClassOf hume:Material ;
        rdfs:comment "A cermet is a composite material composed of ceramic and metal materials."@en ;
        rdfs:seeAlso <https://en.wikipedia.org/wiki/Cermet> ,
                     "Tinklepaugh, James R. (1960). Cermets. New York: Reinhold Publishing Corporation. ASIN B0007E6FO4."@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "CerMet"@en ;
        :elucidation "A composite material composed of a ceramic phase (e.g. carbides such as TiC or WC) bonded by a metallic phase (binder)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CharacterisationComponent
:CharacterisationComponent rdf:type owl:Class ;
                           rdfs:subClassOf hume:Component ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Characterisation Component"@en ;
                           :elucidation "A component of a characterisation device that takes part directly in the measurement by interacting with the specimen, such as an indenter or a wear pin."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CharacterisationDevice
:CharacterisationDevice rdf:type owl:Class ;
                        rdfs:subClassOf hume:Device ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Characterisation Device"@en ;
                        :elucidation "A device used to carry out a characterisation process, i.e. to measure one or more properties of a sample."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CharacterisationProperty
:CharacterisationProperty rdf:type owl:Class ;
                          rdfs:subClassOf hume:Property ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Characterisation Property"@en ;
                          :elucidation "A property of a sample (e.g. of a coating or a material) that is determined through a characterisation process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ChemicalComposition
:ChemicalComposition rdf:type owl:Class ;
                     rdfs:subClassOf :Composition ;
                     rdfs:isDefinedBy <https://w3id.org/emmo#EMMO_7efd64d1_05a1_49cd_a7f0_783ca050d4f3> ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Chemical Composition"@en ;
                     :elucidation "A composition expressing the type and relative amount (as atomic, weight or volume fraction) of the chemical elements or compounds that constitute a material."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Cleaning
:Cleaning rdf:type owl:Class ;
          rdfs:subClassOf :SubstratePreparation ;
          rdfs:comment """This is the first step for the substrate preparation.
After removing all contaminants, parts should be protected from airborne debris and fingerprints and should be handled with clean fixtures and materials."""@en ;
          rdfs:isDefinedBy "Anon. (2013), Introduction to Coating Design and Processing, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                           "EN 13507:2018: Thermal Spraying - Pre-treatment of surfaces of metallic parts and components for thermal spraying." ;
          rdfs:seeAlso "Fauchais, Pierre L.; Heberlein, Joachim VR; Boulos, Maher I. Thermal spray fundamentals: from powder to part. Springer Science & Business Media, 2014." ,
                       "J. Knapp, D. Lemen (2013), Precoating Operations, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Degreasing"@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Cleaning"@en ;
          :elucidation "The process removes all contaminants, such as scale, oil, grease, and paint, from the surface to be roughened and coated."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CoatedSubstrate
:CoatedSubstrate rdf:type owl:Class ;
                 rdfs:subClassOf hume:System ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty hume:hasComponent ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Coating
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty hume:hasComponent ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Substrate
                                 ] ;
                 owl:hasKey ( :labCode
                            ) ,
                            ( :sampleID
                            ) ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Coated Substrate"@en ;
                 :elucidation "A substrate with a deposited coating layer"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Coating
:Coating rdf:type owl:Class ;
         rdfs:subClassOf hume:Component ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty hume:isComponentOf ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :CoatedSubstrate
                         ] ;
         rdfs:comment "Definition adapted from ISO 14917:2017: Thermal Spraying - Terminology, classification."@en ;
         rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Deposit"@en ,
                                                        "Layer"@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Coating"@en ;
         :elucidation "A layer of material built up onto the substrate by a thermal spray process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CoatingThickness
:CoatingThickness rdf:type owl:Class ;
                  rdfs:subClassOf :CharacterisationProperty ,
                                  :Thickness ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Coating Thickness"@en ;
                  :elucidation "The thickness of the coating deposited on the substrate, i.e. the distance between the substrate-coating interface and the outer surface of the coating, measured perpendicularly to the substrate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CoatingWeight
:CoatingWeight rdf:type owl:Class ;
               rdfs:subClassOf :ThermalSprayingProcessProperty ;
               rdfs:comment "The difference between the initial weight and the final weight provides the coating weight value, which is a direct measure of the amount of material deposited on the substrate during the process. This calculation is useful for monitoring the effectiveness of the deposition process, the amount of material used, and the quality of the applied coating"@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Coating Weight"@en ;
               :elucidation "The weight of the coating applied to the substrate, determined by measuring the weight of the sample before and after the coating has been deposed."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ColdSprayTorch
:ColdSprayTorch rdf:type owl:Class ;
                rdfs:subClassOf :SprayTorch ;
                rdfs:comment """The torch has no combustion chamber.
The gas is pre-heated with electrical resistance systems that are located in the torch itself and/or in external heating units.
Nozzles are convergent/divergent; they are usually interchangeable and vary in shape, size, and material, to achieve specific spray patterns and avoid clogging.
Cold Spray torches can either have a water-cooled nozzle or (especially in low-pressure models) no nozzle cooling system."""@en ;
                rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
                rdfs:seeAlso "J. Karthikeyan (2013), Cold Spray Process, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Cold Spray Gun"@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Cold Spray Torch"@en ;
                :elucidation "A thermal spray torch specifically designed to perform the Cold Spray process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CombustionChamber
:CombustionChamber rdf:type owl:Class ;
                   rdfs:subClassOf :TorchComponent ;
                   rdfs:comment """Fuel and comburent can be pre-mixed before entering the combustion chamber, as in most gas-fuelled HVOF and HVAF torch types, or they can be mixed in the combustion chamber, as in most liquid-fuelled HVOF torches.
Sometimes, the convergent part of the nozzle can also act as a combustion chamber."""@en ;
                   rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Combustion Chamber"@en ;
                   :elucidation "The combustion chamber is the location within a HVOF or HVAF torch where a confined fuel-comburent combustion takes place at pressures above ambient pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Composition
:Composition rdf:type owl:Class ;
             rdfs:subClassOf hume:Property ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Composition"@en ;
             :elucidation "A property expressing the type and relative amount of the constituents (chemical elements, compounds or phases) of a material."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ControlSystem
:ControlSystem rdf:type owl:Class ;
               rdfs:subClassOf hume:System ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Control System"@en ;
               :elucidation "A system that monitors and regulates the operation of other systems or devices by acting on their operating parameters."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ControlUnit
:ControlUnit rdf:type owl:Class ;
             rdfs:subClassOf :ControlSystem ,
                             :ThermalSprayingComponent ;
             rdfs:comment """The control unit is the main user interface to control the process and ensures safety, control and repeatability.
It can feature analogue and/or digital controls and can feature various degrees of automation. It can optionally record and store the measured quantities.
It can operate on open- or closed-loop principles."""@en ;
             rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Command Panel"@en ,
                                                            "Command Unit"@en ,
                                                            "Control Panel"@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Control Unit"@en ;
             :elucidation "The control unit is a system that controls the operation of the thermal spray system, specifically managing gas flows, powder feed, torch startup/shutdown, turntable and manipulator/robot movements, gun cooling system."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CoolingSystem
:CoolingSystem rdf:type owl:Class ;
               rdfs:subClassOf hume:System ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Cooling System"@en ;
               :elucidation "A system that removes heat from an object or device by means of a cooling fluid (liquid or gas) in order to keep its temperature within acceptable limits."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CorrosionCurrentDensity
:CorrosionCurrentDensity rdf:type owl:Class ;
                         rdfs:subClassOf :CharacterisationProperty ;
                         rdfs:seeAlso "Pierre R. Roberge (2000), Handbook of Corrosion Engineering. McGraw-Hill, New York. D.J. De Renzo (1985), CORROSION RESISTANT MATERIALS HANDBOOK, Fourth Edition. NOYES DATA CORPORATION Park Ridge, New Jersey, U.S.A." ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Corrosion Current Density"@en ;
                         :elucidation "The current corrosion density value represents the rate at which a metal or alloy is corroding in a specific environment. It is a measure of the amount of metal ions that are being released from the material due to the corrosion process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CorrosionPotential
:CorrosionPotential rdf:type owl:Class ;
                    rdfs:subClassOf :CharacterisationProperty ;
                    rdfs:seeAlso "Pierre R. Roberge (2000), Handbook of Corrosion Engineering. McGraw-Hill, New York. D.J. De Renzo (1985), CORROSION RESISTANT MATERIALS HANDBOOK, Fourth Edition. NOYES DATA CORPORATION Park Ridge, New Jersey, U.S.A." ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Corrosion Potential"@en ;
                    :elucidation "The corrosion potential value represents the tendency of a metal or alloy to corrode in a specific environment. It is a measure of the electrochemical potential difference between the metal and its environment, which is the driving force for the corrosion process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#CriticalLoad
:CriticalLoad rdf:type owl:Class ;
              rdfs:subClassOf :CharacterisationProperty ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Critical Load"@en ;
              :elucidation "The lowest normal load at which a specific failure event (e.g. cracking, delamination or exposure of the substrate) occurs in a coating during a scratch test (cf. ISO 20502, ASTM C1624)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Density
:Density rdf:type owl:Class ;
         rdfs:subClassOf hume:Property ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Density"@en ;
         :elucidation "Mass per unit volume of a material."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Deposition
:Deposition rdf:type owl:Class ;
            rdfs:subClassOf :ThermalSprayingStage ;
            rdfs:comment """During this stage, the torch is moved in front of the substrates with a specified kinematics and for a specified number of cycles by using the coordinated motion of the turntable and the manipulator or robot.
The substrate can be cooled during the deposition stage to prevent excessive rise in temperatures that would result in high residual stress levels being generated both during and after the deposition process."""@en ;
            rdfs:seeAlso "Anon. (2013), Introduction to Coating Design and Processing, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Build-up"@en ,
                                                           "Coating"@en ,
                                                           "Spraying"@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Deposition"@en ;
            :elucidation "Deposition is the stage of the thermal spray process during which the coating is built up onto the substrate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#DepositionArea
:DepositionArea rdf:type owl:Class ;
                rdfs:subClassOf :ThermalSprayingProcessProperty ;
                rdfs:comment "This area may differ from the total dimensions of the specimen based on the equipment used to block the samples during the process."@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Deposition Area"@en ;
                :elucidation "The area on which the material will actually be deposited and which will be used in subsequent calculations."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#DepositionLength
:DepositionLength rdf:type owl:Class ;
                  rdfs:subClassOf :Length ,
                                  :ThermalSprayingProcessProperty ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty hume:isPropertyOf ;
                                    owl:someValuesFrom :Substrate
                                  ] ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Deposition Length"@en ;
                  :elucidation "The length of the deposition area on the substrate"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#DepositionPassWeights
:DepositionPassWeights rdf:type owl:Class ;
                       rdfs:subClassOf :ThermalSprayingProcessDescription ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty hume:hasPart ;
                                         owl:someValuesFrom :FinalWeight
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty hume:hasPart ;
                                         owl:someValuesFrom :InitialWeight
                                       ] ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Deposition Pass Weights"@en ;
                       :elucidation "A dataset containing the weights before and after a deposition pass/cycle."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#DepositionSpeed
:DepositionSpeed rdf:type owl:Class ;
                 rdfs:subClassOf :ThermalSprayingProcessProperty ,
                                 :Velocity ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Deposition Speed"@en ;
                 :elucidation "The relative traverse speed between torch and substrate"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#DepositionWidth
:DepositionWidth rdf:type owl:Class ;
                 rdfs:subClassOf :ThermalSprayingProcessProperty ,
                                 :Width ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty hume:isPropertyOf ;
                                   owl:someValuesFrom :Substrate
                                 ] ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Deposition Width"@en ;
                 :elucidation "The width of the deposition area on the substrate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Diameter
:Diameter rdf:type owl:Class ;
          rdfs:subClassOf :Length ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Diameter"@en ;
          :elucidation "The length of a straight line segment that passes through the centre of a circle or sphere and has its endpoints on its boundary; for non-spherical objects an equivalent diameter may be used."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Diffractometer
:Diffractometer rdf:type owl:Class ;
                rdfs:subClassOf :CharacterisationDevice ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Diffractometer"@en ;
                :elucidation "A characterisation device that measures the pattern of radiation (X-rays, electrons or neutrons) diffracted by a sample."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Diffractometry
:Diffractometry rdf:type owl:Class ;
                rdfs:subClassOf hume:Characterisation ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Diffractometry"@en ;
                :elucidation "A characterisation technique that analyses the pattern of radiation (X-rays, electrons or neutrons) diffracted by a sample to determine its crystal structure, phases and lattice strains."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Distance
:Distance rdf:type owl:Class ;
          rdfs:subClassOf :Length ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Distance"@en ;
          :elucidation "The length of the shortest straight line segment between two points or objects."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ElasticModulus
:ElasticModulus rdf:type owl:Class ;
                rdfs:subClassOf :CharacterisationProperty ;
                rdfs:isDefinedBy "ISO 14577 (Instrumented indentation test)" ,
                                 "ISO 80000-4:2019" ;
                rdfs:seeAlso "F. Cardarelli (2008), Materials Handbook: A Concise Desktop Reference, second edition. Springer, London. G.T. Murray (1997), Handbook of Materials Selection for Engineering Applications. CRC Press." ;
                <http://www.w3.org/2004/02/skos/core#altLabel> "Young Modulus"@en ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Elastic Modulus"@en ;
                :elucidation "The proportionality coefficient between the stress applied to a material and the resulting strain within the linear reversible deformation regime."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ElectronDiffractometry
:ElectronDiffractometry rdf:type owl:Class ;
                        rdfs:subClassOf :Diffractometry ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Electron Diffractometry"@en ;
                        :elucidation "A diffractometry technique that uses an electron beam as the radiation source, typically within a scanning or transmission electron microscope (e.g. EBSD, selected-area electron diffraction)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ErosiveWearRate
:ErosiveWearRate rdf:type owl:Class ;
                 rdfs:subClassOf :WearRate ;
                 rdfs:seeAlso """ASTM G76-18: Erosion Test by Solid Particle Impingement Using Gas Jet
ASTM G211-14(2020): Elevated Temperature Erosion Test by Solid Particle Impingement Using Gas Jet""" ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Erosive Wear Rate"@en ;
                 :elucidation """The erosive wear rate (or erosion rate) is a measure of the loss of material from a surface due to erosion by solid particles carried by a compressible (gas) or incompressible (water) fluid flow.
The erosive wear rate is expressed as the volume of material removed per unit mass of impinging solid particles."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#FIB
:FIB rdf:type owl:Class ;
     rdfs:subClassOf hume:Characterisation ;
     <http://www.w3.org/2004/02/skos/core#altLabel> "FIB"@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Focused Ion Beam"@en ;
     :elucidation "A technique that uses a finely focused ion beam (typically Ga+) to image, mill or deposit material at the micro- and nanoscale, e.g. to prepare cross-sections, TEM lamellae or micropillars."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#FeedRate
:FeedRate rdf:type owl:Class ;
          rdfs:subClassOf hume:Property ;
          rdfs:isDefinedBy "ISO 80000-4:2019" ;
          rdfs:seeAlso "Glossary of Terms, in: R.C. Tucker Jr. (Ed.), ASM Handbook Vol. 5A, ASM International, Materials Park, OH, USA, 2013, pp. 351-381." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Feed Rate"@en ;
          :elucidation "The mass of material that passes through a given section of a conduit per unit time."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#FinalWeight
:FinalWeight rdf:type owl:Class ;
             rdfs:subClassOf :PlateWeight ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Final Weight"@en ;
             :elucidation "The final weight of the coated substrate plate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Fixture
:Fixture rdf:type owl:Class ;
         rdfs:subClassOf :HoldingSystem ,
                         :ThermalSprayingComponent ;
         rdfs:comment """The fixture must be designed to hold the substrates in a proper configuration so that, in combination with the motion imparted by the turntable and the manipulator, the thermal spray jet is perpendicular to the substrate surface for as long as possible, and should also allow to achieve the desired relative linear velocity and trajectories.
Shadow masks can be integrated in the fixture.
Fixtures are usually permanent but may need periodic regeneration to remove deposits that build up in areas of the fixture exposed to the thermal spray jet."""@en ;
         rdfs:seeAlso "J. Knapp, D. Lemen (2013), Precoating Operations, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Tool"@en ,
                                                        "Tooling"@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Fixture"@en ;
         :elucidation "The fixture is a suitably designed system to hold one or more substrates allowing their mounting on a turntable with a suitable geometrical configuration with respect to the thermal spray torch and the manipulator."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#FlowRate
:FlowRate rdf:type owl:Class ;
          rdfs:subClassOf hume:Property ;
          rdfs:isDefinedBy "ISO 80000-4:2019" ;
          rdfs:seeAlso "Glossary of Terms, in: R.C. Tucker Jr. (Ed.), ASM Handbook Vol. 5A, ASM International, Materials Park, OH, USA, 2013, pp. 351-381." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Flow Rate"@en ;
          :elucidation "The volume of a gas passing across the section of a conduit per unit time"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Force
:Force rdf:type owl:Class ;
       rdfs:subClassOf hume:Property ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Force"@en ;
       :elucidation "A vector quantity expressing an interaction that changes, or tends to change, the state of motion or the shape of a body; equal to the rate of change of its momentum."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#FractureToughness
:FractureToughness rdf:type owl:Class ;
                   rdfs:subClassOf :CharacterisationProperty ;
                   rdfs:seeAlso "F. Cardarelli (2008), Materials Handbook: A Concise Desktop Reference, second edition. Springer, London. G.T. Murray (1997), Handbook of Materials Selection for Engineering Applications. CRC Press." ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Fracture Toughness"@en ;
                   :elucidation "Toughness is the ability of a material to resist fracture or failure when subjected to stress, shock, or impact. It is a property of a material that combines its strength and its ability to absorb energy without breaking."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#FrictionCoefficient
:FrictionCoefficient rdf:type owl:Class ;
                     rdfs:subClassOf :CharacterisationProperty ;
                     rdfs:isDefinedBy "ISO 80000-4:2019" ;
                     rdfs:seeAlso """ASTM G99-17: Pin-on-Disc Sliding Test
ASTM G133-05(2016): Linearly Reciprocating Ball-on-Flat Sliding Test
ASTM G77-17: Block-on-Ring Sliding Test""" ,
                                  "Gwidon W. Stachowiak (2006), WEAR–MATERIALS, MECHANISMSAND PRACTICE, JohnWiley&SonsLtd, The Atrium, Southern Gate, Chichester, West Sussex, England" ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Friction Coefficient"@en ;
                     :elucidation """Proportionality factor between the magnitude of the tangential friction force applied to contacting bodies to maintain (kinetic friction coefficient) or initiate (static friction coefficient) relative motion, and the magnitude of the normal contact force between the bodies.
The friction coefficient is a dimensionless value that measures the resistance to relative motion, caused by dissipative effects such as asperity-level adhesion, abrasion, (visco)elastic hysteresis, third-body effects."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#G200NanoIndenter
:G200NanoIndenter rdf:type owl:Class ;
                  rdfs:subClassOf :NanoIndenter ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Nano Indenter G200"@en ;
                  :elucidation "A Nano Indenter G200 (KLA, formerly Keysight/Agilent), an instrumented nanoindentation testing system."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GasFeedDescription
:GasFeedDescription rdf:type owl:Class ;
                    rdfs:subClassOf hume:Description ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty hume:hasDatum ;
                                      owl:someValuesFrom :FlowRate
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty hume:hasDatum ;
                                      owl:someValuesFrom :Pressure
                                    ] ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Gas Feed Description"@en ;
                    :elucidation "A collection of properties to characterise a gas feed into a device or process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GasFeeding
:GasFeeding rdf:type owl:Class ;
            rdfs:subClassOf :ThermalSprayingSubProcess ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Gas Feeding"@en ;
            :elucidation "A thermal spraying sub-process that supplies the process gases (e.g. fuel, oxygen, air, carrier or propellant gas) to the thermal spray torch at controlled flow rates and pressures."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GasFuelledHVOFTorch
:GasFuelledHVOFTorch rdf:type owl:Class ;
                     rdfs:subClassOf :HVOFTorch ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Gas-Fuelled HVOF Torch"@en ;
                     :elucidation "An HVOF torch in which the fuel fed into the combustion chamber is a gas (e.g. hydrogen, propane, propylene, methane)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GasSupplySystem
:GasSupplySystem rdf:type owl:Class ;
                 rdfs:subClassOf :SupplySystem ;
                 rdfs:comment "This system is designed to provide consistent, safe, and high-quality supply of gases to the thermal spray system. Gases other than air are usually taken from compressed gas bottles, although other sources are possible (e.g. in-situ hydrogen generators). The flow can be pressure- and/or volume-flow controlled."@en ;
                 rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Gas Supply System"@en ;
                 :elucidation "The gas supply system feeds and regulates the flow of the various process gases to the thermal spray system"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlasting
:GritBlasting rdf:type owl:Class ;
              rdfs:subClassOf :Roughening ;
              rdfs:isDefinedBy "EN 13507:2018: Thermal Spraying - Pre-treatment of surfaces of metallic parts and components for thermal spraying."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting"@en ;
              :elucidation "Method of cleaning or finishing using an abrasive in a stream of compressed air, with or without water"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingAirPressure
:GritBlastingAirPressure rdf:type owl:Class ;
                         rdfs:subClassOf :GritBlastingProcessProperties ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting Air Pressure"@en ;
                         :elucidation "The pressure of the compressed air used in the grit blasting process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingGPLFuelFirstStagePressure
:GritBlastingGPLFuelFirstStagePressure rdf:type owl:Class ;
                                       rdfs:subClassOf :GritBlastingProcessProperties ;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting GPL Fuel First Stage Pressure"@en ;
                                       :elucidation "The pressure of the LPG (GPL) fuel fed to the first (primary) combustion stage of the torch during grit blasting."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingGPLFuelSecondStagePressure
:GritBlastingGPLFuelSecondStagePressure rdf:type owl:Class ;
                                        rdfs:subClassOf :GritBlastingProcessProperties ;
                                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting GPL Fuel Second Stage Pressure"@en ;
                                        :elucidation "The pressure of the LPG (GPL) fuel fed to the second (secondary) combustion stage of the torch during grit blasting."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingGPLFuelTotalConsumptionPerLayer
:GritBlastingGPLFuelTotalConsumptionPerLayer rdf:type owl:Class ;
                                             rdfs:subClassOf :GritBlastingProcessProperties ;
                                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting GPL Fuel Total Consumption Per Layer"@en ;
                                             :elucidation "The volume of liquid LPG (GPL) used during grit blasting per unit of surface area for each layer."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingGPLFuelTotalFlowRate
:GritBlastingGPLFuelTotalFlowRate rdf:type owl:Class ;
                                  rdfs:subClassOf :GritBlastingProcessProperties ;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting GPL Fuel Total Flow Rate"@en ;
                                  :elucidation "The total flow rate of LPG (GPL) fuel fed to the torch during grit blasting, summed over all combustion stages."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingN2CarrierConsumptionPerLayer
:GritBlastingN2CarrierConsumptionPerLayer rdf:type owl:Class ;
                                          rdfs:subClassOf :GritBlastingProcessProperties ;
                                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting N₂ Carrier Consumption Per Layer"@en ;
                                          :elucidation "The volume of nitrogen carrier gas used during grit blasting per unit of surface area for each layer."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingN2CarrierFlowRate
:GritBlastingN2CarrierFlowRate rdf:type owl:Class ;
                               rdfs:subClassOf :GritBlastingProcessProperties ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting N₂ Carrier Flow Rate"@en ;
                               :elucidation "The flow rate of the nitrogen carrier gas that conveys the abrasive grit into the torch during grit blasting."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GritBlastingProcessProperties
:GritBlastingProcessProperties rdf:type owl:Class ;
                               rdfs:subClassOf :ThermalSprayingProcessProperty ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Grit Blasting Process Properties"@en ;
                               :elucidation "A thermal spraying process property that describes the conditions of a grit blasting process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#GunCoolingSystem
:GunCoolingSystem rdf:type owl:Class ;
                  rdfs:subClassOf :CoolingSystem ;
                  rdfs:comment """The gun cooling system can use either liquids (deionized water), gases (compressed air), or a mixture or both.
The system can feature flow meters and temperature sensors to monitor the flow rate of cooling medium and its inlet and outlet temperature, thereby allowing a quantification of the thermal power lost by the torch to the cooling system."""@en ;
                  rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                  <http://www.w3.org/2004/02/skos/core#altLabel> "Cooling Circuit"@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Gun Cooling System"@en ;
                  :elucidation "A system that delivers a liquid or gaseous cooling fluid to the thermal spray torch to prevent overheating of critical parts"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#H2Feed
:H2Feed rdf:type owl:Class ;
        rdfs:subClassOf :GasFeedDescription ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty hume:hasDatum ;
                          owl:someValuesFrom :H2FlowRate
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty hume:hasDatum ;
                          owl:someValuesFrom :H2Pressure
                        ] ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "H₂ Feed"@en ;
        :elucidation "A gas feed description of the hydrogen fuel fed to a device or process, characterised by its flow rate and pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#H2FlowRate
:H2FlowRate rdf:type owl:Class ;
            rdfs:subClassOf :FlowRate ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "H₂ Flow Rate"@en ;
            :elucidation "The flow rate of hydrogen fuel (in flow meter reading, FMR)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#H2Pressure
:H2Pressure rdf:type owl:Class ;
            rdfs:subClassOf :Pressure ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "H₂ Pressure"@en ;
            :elucidation "The hydrogen pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAF
:HVAF rdf:type owl:Class ;
      rdfs:subClassOf :ThermalSpraying ;
      owl:hasKey ( :processID
                 ) ;
      rdfs:comment """HVAF (High Velocity Air Fuel) is a thermal spray process similar to HVOF but using compressed air instead of pure oxygen as the comburent. Fuels are typically gaseous (propane, propylene); powder injection is typically axial in the combustion chamber. Nozzles may feature a secondary air-fuel injection. Fuel mixtures, e.g. propane+hydrogen, can sometimes be employed.
Compressed air is also used to cool the torch before being injected into the combustion chamber, thus achieving regenerative pre-heating."""@en ;
      rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
      rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                   "Fauchais, Pierre L.; Heberlein, Joachim VR; Boulos, Maher I. Thermal spray fundamentals: from powder to part. Springer Science & Business Media, 2014." ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "HVAF Spraying"@en ,
                                                     "High Velocity Air Fuel"@en ,
                                                     "High Velocity Air Fuel Spraying"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF"@en ;
      :elucidation "A thermal spray process that involves accelerating and heating a feedstock material in powder form by feeding it into a stream of exhaust gases originating from the confined combustion of air and fuel(s) at high pressure and the subsequent expansion of the combustion products through a nozzle."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFAirPressure
:HVAFAirPressure rdf:type owl:Class ;
                 rdfs:subClassOf :HVAFProperty ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF Air Pressure"@en ;
                 :elucidation "The pressure of the compressed air fed to the HVAF torch as the comburent."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFGPLFuelFirstStagePressure
:HVAFGPLFuelFirstStagePressure rdf:type owl:Class ;
                               rdfs:subClassOf :HVAFProperty ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF GPL Fuel First Stage Pressure"@en ;
                               :elucidation "The pressure of the LPG (GPL) fuel fed to the first (primary) combustion stage of the HVAF torch."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFGPLFuelSecondStagePressure
:HVAFGPLFuelSecondStagePressure rdf:type owl:Class ;
                                rdfs:subClassOf :HVAFProperty ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF GPL Fuel Second Stage Pressure"@en ;
                                :elucidation "The pressure of the LPG (GPL) fuel fed to the second (secondary) combustion stage of the HVAF torch."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFGPLFuelTotalConsumptionPerLayer
:HVAFGPLFuelTotalConsumptionPerLayer rdf:type owl:Class ;
                                     rdfs:subClassOf :HVAFProperty ;
                                     <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF GPL Fuel Total Consumption Per Layer"@en ;
                                     :elucidation "Volume of liquid LPG used for each layer per unit of surface area."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFGPLFuelTotalFlowRate
:HVAFGPLFuelTotalFlowRate rdf:type owl:Class ;
                          rdfs:subClassOf :HVAFProperty ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF GPL Fuel Total Flow Rate"@en ;
                          :elucidation "The total flow rate of LPG (GPL) fuel fed to the HVAF torch, summed over all combustion stages."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFN2CarrierConsumptionPerLayer
:HVAFN2CarrierConsumptionPerLayer rdf:type owl:Class ;
                                  rdfs:subClassOf :HVAFProperty ;
                                  <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF N₂ Carrier Consumption Per Layer"@en ;
                                  :elucidation "The volume of nitrogen carrier gas used per unit of surface area for each deposited layer in the HVAF process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFN2CarrierFlowRate
:HVAFN2CarrierFlowRate rdf:type owl:Class ;
                       rdfs:subClassOf :HVAFProperty ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF N₂ Carrier Flow Rate"@en ;
                       :elucidation "The flow rate of the nitrogen carrier gas that conveys the powder feedstock from the powder feeder into the HVAF torch."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFProperty
:HVAFProperty rdf:type owl:Class ;
              rdfs:subClassOf :ThermalSprayingProcessProperty ;
              rdfs:comment "Property that is specific to HVAF process."@en ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF Process Properties"@en ;
              :elucidation "A thermal spraying process property that is specific to the HVAF process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFTorch
:HVAFTorch rdf:type owl:Class ;
           rdfs:subClassOf :ThermalSprayTorch ;
           rdfs:comment """HVAF torches can usually be fit with multiple, interchangeable, and separate combustion chambers and nozzles, offering more hardware variety in a single device than do HVOF torches. Often, the combustion chamber ends with a converging/diverging nozzle and a separate, secondary nozzle is installed downstream of the chamber-integrated nozzle.
Process gas flows are usually regulated by adjusting their inlet pressure, whilst volume flow rates can be optionally measured but are not directly controlled."""@en ;
           rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
           rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "HVAF Gun"@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "HVAF Torch"@en ;
           :elucidation "A thermal spray torch specifically designed to perform the HVAF process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVOF
:HVOF rdf:type owl:Class ;
      rdfs:subClassOf :ThermalSpraying ;
      owl:hasKey ( :processID
                 ) ;
      rdfs:comment """Fuels can be liquid (e.g. kerosene), gaesous (e.g. hydrogen, propane, prolpylene, ethene, ecc.)
Powders can be injected axially in the combustion chamber or radially downstream of the combustion chamber, which affects their heating and acceleration history
Expansion nozzles can be converging or converging/diverging (De Laval type) and can have a straight barrel downstream"""@en ;
      rdfs:isDefinedBy "EN 1395-2:2007: Thermal Spraying - Acceptance inspection of thermal spraying equipment - Part 2: Flame spraying including HVOF" ,
                       "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
      rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                   "Fauchais, Pierre L.; Heberlein, Joachim VR; Boulos, Maher I. Thermal spray fundamentals: from powder to part. Springer Science & Business Media, 2014." ;
      <http://www.w3.org/2004/02/skos/core#altLabel> "HVOF Spraying"@en ,
                                                     "High Velocity Oxygen Fuel"@en ,
                                                     "High Velocity Oxygen Fuel Spraying"@en ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "HVOF"@en ;
      :elucidation "A thermal spray process that involves accelerating and heating a feedstock material in powder form by feeding it into a stream of exhaust gases originating from the confined combustion of oxygen and fuel(s) at high pressure and the subsequent expansion of the combustion products through a nozzle."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HVOFTorch
:HVOFTorch rdf:type owl:Class ;
           rdfs:subClassOf :ThermalSprayTorch ;
           rdfs:comment """HVOF torches are available in multiple variants that differ in construction details such as presence/absence of a distinct combustion chamber, type of nozzle, presence or absence of interchangeable barrels after the nozzle, powder injection location, fuel type, which result in different particle velocity/temperature combinations:

- Gas-fuelled HVOF torch with hybrid air/water cooling: no separate combustion chamber, the powder is injected axially in the convergent nozzle section and the pre-mixed oxygen-fuel flow is delivered co-axially, with compressed air flowing along the convergent nozzle wall for cooling. The divergent part of the nozzle is water-cooled. The nozzle has fixed geometry and is not replaceable.

- Gas-fuelled HVOF torch with single-piece combustion chamber, convergent nozzle, and cylindrical barrel. The powder is injected axially in the combustion chamber and the entire torch is water-cooled

- Gas-fuelled HVOF torch with combustion chamber at 90° with respect to the convergent-straight nozzle and axial powder injection at the nozzle inlet.

- HVOF torch with atomization of liquid fuel in a combustion chamber where combustion with oxygen is triggered by a spark plug; the chamber ends with a convergent-divergent nozzle followed by an interchangeable straight barrel; powder is injected radially at the barrel inlet.

Process gases are usually fed at constant pressure with a volume flow rate-control system."""@en ;
           rdfs:isDefinedBy "EN 1395-2:2007: Thermal Spraying - Acceptance inspection of thermal spraying equipment - Part 2: Flame spraying including HVOF" ,
                            "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
           rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "HVOF Gun"@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "HVOF Torch"@en ;
           :elucidation "A thermal spray torch specifically designed to perform the HVOF process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Hardness
:Hardness rdf:type owl:Class ;
          rdfs:subClassOf :CharacterisationProperty ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Hardness"@en ;
          :elucidation "A hardness test measures a material's resistance to permanent surface deformation by pressing a harder indenter into its surface with a specific force. The hardness is determined by measuring the depth of the indentation or the size of the resulting impression, using methods like Rockwell, Vickers, Knoop, and Brinell. These tests are used for material comparison, quality control, and to determine a material's suitability for a particular application."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HighEntropyAlloy
:HighEntropyAlloy rdf:type owl:Class ;
                  rdfs:subClassOf :Alloy ;
                  owl:disjointWith :Stellite ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "High Entropy Alloy"@en ;
                  :elucidation "An alloy composed of multiple (typically four or more) principal elements, each present in substantial concentration, rather than of a single base element; the high configurational entropy of mixing tends to stabilise simple solid-solution phases."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HighPressureColdSpraying
:HighPressureColdSpraying rdf:type owl:Class ;
                          rdfs:subClassOf :CGS ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "High Pressure Cold Spraying"@en ;
                          :elucidation "A cold gas spraying process operated at high process gas pressure (typically above about 2.5 MPa and up to 5–7 MPa), usually with preheated nitrogen or helium, in which the powder is injected upstream of the nozzle throat."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HighSpeed3DMapping
:HighSpeed3DMapping rdf:type owl:Class ;
                    rdfs:subClassOf :Nanoindentation ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "High-Speed 3D Mapping"@en ;
                    :elucidation "A nanoindentation technique in which a large array of shallow, rapid indentations (several per second) is made over a region of the surface to produce spatially resolved maps of hardness and elastic modulus (e.g. KLA NanoBlitz 3D)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HighVelocityIndentationHardness
:HighVelocityIndentationHardness rdf:type owl:Class ;
                                 rdfs:subClassOf :Hardness ;
                                 <http://www.w3.org/2004/02/skos/core#altLabel> "HVI"@en ;
                                 <http://www.w3.org/2004/02/skos/core#prefLabel> "High Velocity Indentation Hardness"@en ;
                                 :elucidation "A dynamic hardness determined by impacting the surface of a sample with an indenter at high velocity and evaluating the resulting impression, thereby probing the material response at high strain rates."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#HoldingSystem
:HoldingSystem rdf:type owl:Class ;
               rdfs:subClassOf hume:System ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Holding System"@en ;
               :elucidation "A system that holds and positions one or more substrates during the thermal spray process, such as a fixture mounted on a turntable."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Indentation
:Indentation rdf:type owl:Class ;
             rdfs:subClassOf hume:Characterisation ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Indentation"@en ;
             :elucidation "A characterisation technique in which an indenter of known geometry and mechanical properties is pressed into the surface of a sample under controlled load or displacement in order to measure mechanical properties such as hardness and elastic modulus."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#IndentationCurve
:IndentationCurve rdf:type owl:Class ;
                  rdfs:subClassOf :CharacterisationProperty ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Indentation Curve"@en ;
                  :elucidation "The load versus penetration depth curve recorded during the loading and unloading phases of an instrumented indentation test."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#IndentationHardness
:IndentationHardness rdf:type owl:Class ;
                     rdfs:subClassOf :Hardness ;
                     rdfs:seeAlso """SO 14577-1:2015
ISO 14577-2:2015
ISO 14577-3:2015
ISO 14577-4:2016""" ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "HIT"@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Indentation Hardness"@en ;
                     :elucidation """The indentation hardness (HIT) is specifically defined as the average contact pressure between the indenter and the indented material, i.e. HIT = Fmax/Ap, were Fmax = maximum applied load and Ap = contact area projected into the plane of the sample surface (\"projected contact area\").
It is obtained by a depth-sensing indentation measure, where the applied load (F) and indenter penetration (h) are recorded continuously during penetration and retraction.
Fmax is directly obtained by the load recording; Ap is obtained by processing the load-penetration curve according to the Oliver-Pharr procedure.
A Vickers or Berkovich indenter can be used interchangeably.
Indentation hardness is specifically told into:
- Macro-hardness: 2 N ≤ Fmax ≤ 30 kN
- Micro-hardness: Fmax < 2 N; h > 0.2 μm
- Nano-hardness: h ≤ 0.2 μm"""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Indenter
:Indenter rdf:type owl:Class ;
          rdfs:subClassOf :CharacterisationComponent ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Indenter"@en ;
          :elucidation "A characterisation component consisting of a hard tip of defined geometry (e.g. Vickers, Berkovich, spherical, cube-corner), usually made of diamond, that is pressed into the surface of the specimen during an indentation test."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#InitialWeight
:InitialWeight rdf:type owl:Class ;
               rdfs:subClassOf :PlateWeight ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Initial Weight"@en ;
               :elucidation "The initial weight of the uncoated substrate plate (after substrate preparation, e.g. grit-blasting and acetone-cleaning)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LECO
:LECO rdf:type owl:Class ;
      rdfs:subClassOf hume:Characterisation ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "LECO"@en ;
      :elucidation "LECO analysis is a method for reliably determining the concentration of gases within metals and oxides, including Carbon, Hydrogen, Nitrogen, Oxygen and Sulfur."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LaserPyrometer
:LaserPyrometer rdf:type owl:Class ;
                rdfs:subClassOf :Pyrometer ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Laser Pyrometer"@en ;
                :elucidation """An infrared radiation thermometer that projects a laser beam on to a target and uses the reflected laser energy to calculate the target effective emissivity and automatically correct the target temperature (assuming that the target is a diffuse reflector)
https://www.iso.org/obp/ui/#iso:std:iso:10878:ed-1:v1:en:term:1.69"""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Length
:Length rdf:type owl:Class ;
        rdfs:subClassOf hume:Property ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Length"@en ;
        :elucidation "The extent of an object or path along a given direction."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LinearThermalExpansionCoefficient
:LinearThermalExpansionCoefficient rdf:type owl:Class ;
                                   rdfs:subClassOf hume:Property ;
                                   rdfs:isDefinedBy "ISO 80000-5:2019" ;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Linear Thermal Expansion Coefficient"@en ;
                                   :elucidation "Relative change of length of a material with temperature."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LiquidFuelSupplySystem
:LiquidFuelSupplySystem rdf:type owl:Class ;
                        rdfs:subClassOf :SupplySystem ;
                        rdfs:comment "The system is typically based on a volumetric pump. Fuels such as kerosene or paraffin are taken from tanks. This system is usually equipped only in thermal spray system intended to operate with a liquid-fuelled HVOF torch."@en ;
                        rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "Fuel Pump"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Liquid Fuel Supply System"@en ;
                        :elucidation "The liquid fuel supply system feeds and regulated the flow of liquid fuels to a thermal spray system"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LiquidFuelledHVOFTorch
:LiquidFuelledHVOFTorch rdf:type owl:Class ;
                        rdfs:subClassOf :HVOFTorch ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Liquid-Fuelled HVOF Torch"@en ;
                        :elucidation "An HVOF torch in which the fuel fed into the combustion chamber is a liquid, typically kerosene."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Load
:Load rdf:type owl:Class ;
      rdfs:subClassOf :Force ;
      <http://www.w3.org/2004/02/skos/core#prefLabel> "Load"@en ;
      :elucidation "A force applied to an object, e.g. the normal force applied by an indenter or a pin to a specimen during a characterisation test."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LowPressureColdSpraying
:LowPressureColdSpraying rdf:type owl:Class ;
                         rdfs:subClassOf :CGS ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Low Pressure Cold Spraying"@en ;
                         :elucidation "A cold gas spraying process operated at relatively low process gas pressure (typically up to about 1 MPa), usually with air or nitrogen, in which the powder is injected downstream of the nozzle throat, in the diverging section."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#LuchsingerOPTRISCTlaser
:LuchsingerOPTRISCTlaser rdf:type owl:Class ;
                         rdfs:subClassOf :LaserPyrometer ;
                         rdfs:seeAlso <https://www.optris.com/en/products/infrared-thermometers/cslaser-ctlaser-series/> ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Luchsinger OPTRIS CTlaser"@en ;
                         :elucidation "A pyrometer of the Optris CTlaser series (infrared thermometer with laser sighting), supplied by Luchsinger, used for non-contact temperature measurement of the substrate/coating during thermal spraying."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Manipulator
:Manipulator rdf:type owl:Class ;
             rdfs:subClassOf hume:Device ;
             rdfs:comment """Definition adapted from EN 1395-6:2007: Thermal spraying - Acceptance inspection of thermal spraying equipment - Part 6: Manipulator systems.

Typically, two types of manipulators can be employed:
- X-Y or X-Y-Z manipulators that perform linear movements along the respective axes
- Industrial robots, often with 5 or 6 degrees of freedom.

Robots are needed to coat geometrically complex substrates and to achieve higher linear velocities, whilst X-Y or X-Y-Z manipulators are suitable for simple planar or cylindrical substrates.
The manipulator can optionally be synchronized with the turntable to add one more controlled degree of freedom and increase the ability to follow geometrically complex substrates."""@en ;
             rdfs:isDefinedBy "EN 1395-6:2007: Thermal spraying - Acceptance inspection of thermal spraying equipment - Part 6: Manipulator systems." ;
             rdfs:seeAlso "Anon. (2013), Introduction to Coating Design and Processing, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                          "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
             <http://www.w3.org/2004/02/skos/core#altLabel> "Axes Control"@en ,
                                                            "Robot"@en ,
                                                            "Translator"@en ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Manipulator"@en ;
             :elucidation "Manipulators are employed to move the thermal spray torch with respect to the substrate or, more infrequently, to move the substrate with respect to a stationary thermal spray torch."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Masking
:Masking rdf:type owl:Class ;
         rdfs:subClassOf :SubstratePreparation ;
         rdfs:comment """This process is necessary to prevent deposit formation on areas where it is not wanted. It also improves the uniformity of the deposit when coating limited areas.
Three types of masks are used depending on the number of parts to be coated.
Three types of mask can be employed.
A contact mask consists of a tape wrapped onto areas where the substrate must be protected. The tape is withdrawn after grit blasting and, to get rid of residual glue, the area where it covered the surface must be cleaned with a solvent. Masking tapes can be made of: glass fabric plus adhesive or aluminium foil laminated to glass fabric with silicone plus adhesive or similar combinations.
A shadow mask consists of a metal sheet, sometimes being an integral part of the tool, which is placed in front of the area not to be coated and in physical proximity to the surface, typically two to three coating thicknesses away.
A paint-on mask is a paint or slurry that is applied onto the area to be protected and dried or cured.
Masks can be applied before or after grit-blasting because, in some cases, they are required to protect both against grit-blasting and against coating deposition. Tapes and paints are removed and scrapped after the thermal spray process. Shadow masks are used multiple times and can be regenerated by removing the excess material deposited onto them e.g. by grit-blasting or chemical stripping."""@en ;
         rdfs:isDefinedBy "EN 13507:2018: Thermal Spraying - Pre-treatment of surfaces of metallic parts and components for thermal spraying." ,
                          "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
         rdfs:seeAlso "Anon. (2013), Introduction to Coating Design and Processing, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                      "J. Knapp, D. Lemen (2013), Precoating Operations, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Fixturing"@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Masking"@en ;
         :elucidation "The process consists of applying a physical protection to prevent deposit adhesion to areas of the substrate not to be coated"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#MassFlowFeeder
:MassFlowFeeder rdf:type owl:Class ;
                rdfs:subClassOf :PowderFeeder ;
                owl:disjointWith :VolumeFlowFeeder ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Mass Flow Feeder"@en ;
                :elucidation "A powder feeder that meters the powder by controlling its mass flow rate, typically in closed loop on a continuous measurement of the powder mass (e.g. loss-in-weight)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#MaximaTemperatureStandardDeviation
:MaximaTemperatureStandardDeviation rdf:type owl:Class ;
                                    rdfs:subClassOf :Temperature ,
                                                    :ThermalSprayingProcessProperty ;
                                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Maxima Temperatures Standard Deviation"@en ;
                                    :elucidation "Standard deviation of measured temperature peaks of an entity."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#MediumPressureColdSpraying
:MediumPressureColdSpraying rdf:type owl:Class ;
                            rdfs:subClassOf :CGS ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Medium Pressure Cold Spraying"@en ;
                            :elucidation "A cold gas spraying process operated at process gas pressures between the low and high pressure regimes (typically about 1 to 2.5 MPa)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Microhardness
:Microhardness rdf:type owl:Class ;
               rdfs:subClassOf :Hardness ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Microhardness"@en ;
               :elucidation "Microhardness testing measures a material's hardness on a microscopic level by impressing a diamond indenter into its surface with a light load (typically 0.015 to 1 kg)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Microindentation
:Microindentation rdf:type owl:Class ;
                  rdfs:subClassOf :Indentation ;
                  rdfs:seeAlso "ASTM E384-22"@en ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Microindentation"@en ;
                  :elucidation "Microindentation tests are utilized to evaluate and quantify hardness variations that occur over a small distance."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Microindenter
:Microindenter rdf:type owl:Class ;
               rdfs:subClassOf :CharacterisationDevice ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Microindenter"@en ;
               :elucidation "A characterisation device that performs indentation tests in the micro range (ISO 14577: F < 2 N, h > 0.2 µm), e.g. for Vickers microhardness measurements."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#NanoIndenter
:NanoIndenter rdf:type owl:Class ;
              rdfs:subClassOf :CharacterisationDevice ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Nano Indenter"@en ;
              :elucidation "An indentation testing system, designed for nanoscale measurements during characterization and development of a wide range of materials."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Nanoindentation
:Nanoindentation rdf:type owl:Class ;
                 rdfs:subClassOf :Indentation ;
                 rdfs:isDefinedBy <https://w3id.org/emmo/domain/characterisation-methodology/chameo#Nanoindentation> ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Nanoindentation"@en ;
                 :elucidation "An instrumented indentation technique operating at nanometre-scale penetration depths (nano range of ISO 14577, h ≤ 0.2 µm), in which load and depth are recorded continuously to determine properties such as hardness and elastic modulus."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#NominalElectricityConsumption
:NominalElectricityConsumption rdf:type owl:Class ;
                               rdfs:subClassOf :ThermalSprayingProcessProperty ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Nominal Electricity Consumption"@en ;
                               :elucidation "The electrical energy consumption of the spraying process, calculated per second per unit of surface and per layer."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Nozzle
:Nozzle rdf:type owl:Class ;
        rdfs:subClassOf :TorchComponent ;
        rdfs:comment """Definition adapted from ISO 14917:2017: Thermal Spraying - Terminology, classification.
The geometry of the nozzle is responsible for shaping and accelerating the gas flow into a high-velocity stream entraining the particles."""@en ;
        rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
        <http://www.w3.org/2004/02/skos/core#altLabel> "Spray Nozzle"@en ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Nozzle"@en ;
        :elucidation "The nozzle is the part of a thermal spray gun that contains the outlet opening for the spray jet"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#NumberOfCycles
:NumberOfCycles rdf:type owl:Class ;
                rdfs:subClassOf :ThermalSprayingProcessProperty ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Number of Cycles"@en ;
                :elucidation "The number of repetitions of the toolpath program"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#NumberOfPassesPerCycle
:NumberOfPassesPerCycle rdf:type owl:Class ;
                        rdfs:subClassOf :ThermalSprayingProcessProperty ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Number of Passes Per Cycles"@en ;
                        :elucidation "The number of passes within a single repetition of the toolpath program"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#NumberOfPreHeatingPasses
:NumberOfPreHeatingPasses rdf:type owl:Class ;
                          rdfs:subClassOf :ThermalSprayingProcessProperty ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Number of Pre-Heating Passes"@en ;
                          :elucidation "The number of preheating passes"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#O2Feed
:O2Feed rdf:type owl:Class ;
        rdfs:subClassOf :GasFeedDescription ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty hume:hasDatum ;
                          owl:someValuesFrom :O2FlowRate
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty hume:hasDatum ;
                          owl:someValuesFrom :O2Pressure
                        ] ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "O₂ Feed"@en ;
        :elucidation "A gas feed description of the oxygen fed to a device or process, characterised by its flow rate and pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#O2FlowRate
:O2FlowRate rdf:type owl:Class ;
            rdfs:subClassOf :FlowRate ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "O₂ Flow Rate"@en ;
            :elucidation "The flow rate of oxygen (in flow meter reading, FMR)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#O2Pressure
:O2Pressure rdf:type owl:Class ;
            rdfs:subClassOf :Pressure ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "O₂ Pressure"@en ;
            :elucidation "The oxygen pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ParticleSizeDistribution
:ParticleSizeDistribution rdf:type owl:Class ;
                          rdfs:subClassOf hume:Property ;
                          rdfs:isDefinedBy "ISO 13320:2020 - Particle size analysis — Laser diffraction method" ,
                                           "ISO 9276-1" ,
                                           "ISO 9276-2" ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Particle Size Distribution"@en ;
                          :elucidation """This term designates the distribution of sizes of the particles composing a powder.
The size is expressed as equivalent diameter, i.e. the diameter of a sphere of equivalent volume to the actual particle.
The distribution is expressed as a volume distribution, i.e. the fraction of the overall volume of the powder comprised within each size range. A particle size distribution is understood as a volume distribution unless otherwise specified.
Alternatively, it can be expressed as a number distribution, i.e. the fraction of the overall number of particles comprised within each size range. It should be expressly indicated whether the distribution is expressed as a number distribution. Usually, a number distribution results in an over-representation of the finer size ranges.
It is measured by laser scattering, sieving, or image analysis on optical or SEM micrographs of a powder sample.
The distribution is summarized by the 10th, 50th and 90th quantiles or by average and standard deviation."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ParticlesSpeed
:ParticlesSpeed rdf:type owl:Class ;
                rdfs:subClassOf :ThermalSprayingProcessProperty ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Particles Speed"@en ;
                :elucidation "The speed of the sprayed particles travelling towards the substrate"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PhaseComposition
:PhaseComposition rdf:type owl:Class ;
                  rdfs:subClassOf :Composition ;
                  rdfs:seeAlso """EN 13925-1:2003
EN 13925-2:2003
EN 13925-3:2005""" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Phase Composition"@en ;
                  :elucidation """Phase composition refers to the type and relative amount of distinct phases composing a sample.
Phase composition is measured by X-Ray Diffraction (XRD).
The pattern obtained by diffraction of a monochromatic beam of X-rays from a sample allows qualitative identification of its crystalline phases by (computer-assisted) matching to reference databases of diffraction patterns like the ICDD JCPDF-2 or JCPDF-4 databases.
Fitting of the experimental pattern with suitable mathematical functions and integration of peaks' areas allows quantitative assessment of the relative mass fraction of phases by suitable techniques such as the external standard method, internal standard method, or the reference intensity ratio method."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PillarSplitting
:PillarSplitting rdf:type owl:Class ;
                 rdfs:subClassOf :Nanoindentation ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Pillar Splitting"@en ;
                 :elucidation "A nanoindentation technique in which a micropillar, typically milled by FIB, is indented with a sharp (e.g. cube-corner) indenter until it splits; the critical splitting load is used to determine the fracture toughness of the material at the microscale (Sebastiani et al., Phil. Mag. 2015)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PinOnDiscTest
:PinOnDiscTest rdf:type owl:Class ;
               rdfs:subClassOf :WearTest ;
               <http://www.w3.org/2004/02/skos/core#altLabel> "Pin-on-disk Test"@en-us ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Pin-on-disc Wear Test"@en-gb ;
               :elucidation "A pin-on-disc wear test is a standard laboratory method (governed by ASTM G99-95a) used in tribology to evaluate the friction, wear resistance, and durability of materials, coatings, and lubricants."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PinOnDiscTribometer
:PinOnDiscTribometer rdf:type owl:Class ;
                     rdfs:subClassOf :Tribometer ;
                     <http://www.w3.org/2004/02/skos/core#altLabel> "Pin-on-disk Tribometer"@en-us ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Pin-on-Disc Tribometer"@en-gb ;
                     :elucidation "A tribometer in which a stationary pin or ball is pressed with a defined normal load against a rotating disc-shaped specimen, used to measure the friction coefficient and the wear rate (ASTM G99)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Pitch
:Pitch rdf:type owl:Class ;
       rdfs:subClassOf :ThermalSprayingProcessProperty ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Pitch"@en ;
       :elucidation "The pitch distance"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PlateWeight
:PlateWeight rdf:type owl:Class ;
             rdfs:subClassOf :ThermalSprayingProcessProperty ,
                             :Weight ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty hume:isPropertyOf ;
                               owl:someValuesFrom :Substrate
                             ] ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Plate Weight"@en ;
             :elucidation "The weight of the substrate plate with or without deposited substrate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PlateWeightGain
:PlateWeightGain rdf:type owl:Class ;
                 rdfs:subClassOf :ThermalSprayingProcessProperty ,
                                 :Weight ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Plate Weight Gain"@en ;
                 :elucidation "The mass gain of the plate after coating"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PoreSize
:PoreSize rdf:type owl:Class ;
          rdfs:subClassOf hume:Property ;
          rdfs:isDefinedBy "ISO 15901-1:2016 (mercury intrusion porosimetry)" ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Pore Size"@en ;
          :elucidation """Pore size is the equivalent diameter of a pore, i.e. the diameter of a sphere with a volume equivalent to that of the pore.
The pore size in a material can be conveyed either through a complete distribution curve or through an average value. It is measured either by image analysis on optical or scanning electron micrographs, or by mercury intrusion porosimetry."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Porosity
:Porosity rdf:type owl:Class ;
          rdfs:subClassOf hume:Property ;
          rdfs:isDefinedBy "ASTM E2109-01(2021) - Porosity of thermal spray coatings by image analysis" ,
                           "ISO 15901-1:2016 - Mercury intrusion porosimetry" ;
          rdfs:seeAlso "F. Cardarelli (2008), Materials Handbook: A Concise Desktop Reference, second edition. Springer, London. G.T. Murray (1997), Handbook of Materials Selection for Engineering Applications. CRC Press." ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Porosity"@en ;
          :elucidation "Porosity refers to the volume percentage of void space in a material. It is defined as the ratio of the volume of pores or voids in a material to the total volume of the material. . It is measured either by image analysis on optical or scanning electron micrographs, or by mercury intrusion porosimetry."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Powder
:Powder rdf:type owl:Class ;
        rdfs:subClassOf hume:Material ,
                        hume:Solid ;
        owl:hasKey ( :lotNumber
                   ) ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder"@en ;
        :elucidation "A solid material in the form of a large number of fine, loose particles, which can flow when shaken or tilted."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PowderFeedRate
:PowderFeedRate rdf:type owl:Class ;
                rdfs:subClassOf :FeedRate ,
                                :ThermalSprayingProcessProperty ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder Feed Rate"@en ;
                :elucidation "Tthe powder feed rate indicating the amount of powders that are delivered to the spraying system"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PowderFeeder
:PowderFeeder rdf:type owl:Class ;
              rdfs:subClassOf :SupplySystem ;
              rdfs:comment """The definition is adapted from ISO 14917:2017: Thermal Spraying - Terminology, classification.

There are various types of powder feeders that can be distinguished into:
- Pressurized/pressureless feeders - the former type is needed when powder must be fed into a high-pressure region of a thermal spray jet.
- Volume flow controlled/mass flow controlled feeders. The former typically have simpler construction with systems such as rotating grooved discs or endless screws to feed meters volumes of material. The latter are usually based on an electronic balance with an output-based, closed-loop control and can be based on principles such as fluidized bed systems.

The power is usually uptaken with a flow of carrier gas then trnasports it through a tube toward the torch."""@en ;
              rdfs:isDefinedBy "EN 1395-7:2007: Thermal Spraying - Acceptance inspection of thermal spraying equipment - Part 7: Powder feed systems" ,
                               "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
              rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                           "N. Sanpo, J. Wang, C.C. Berndt (2013), Feedstock Material Considerations for Thermal Spray, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder Feeder"@en ;
              :elucidation "The powder feeder is a system for a controlled supply of powder feedstock to a thermal spray torch"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PowderFeederFlowRate
:PowderFeederFlowRate rdf:type owl:Class ;
                      rdfs:subClassOf :ThermalSprayingProcessProperty ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder Feeder Flow Rate"@en ;
                      :elucidation "The gas flow rate carrying the powders from the powder feeder"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PowderFeeding
:PowderFeeding rdf:type owl:Class ;
               rdfs:subClassOf :ThermalSprayingSubProcess ;
               rdfs:comment "Powder feeding is done using either gravimetric or volumetric powder feeders. The feed rate is usually measured as a mass flow rate. The powder is usually carried with a flow of inert gas (nitrogen, argon)."@en ;
               rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder Feeding"@en ;
               :elucidation "Powder feeding is the process of supplying the powder feedstock to a thermal spray torch at a controlled rate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PowderFeedstock
:PowderFeedstock rdf:type owl:Class ;
                 rdfs:subClassOf :ThermalSprayingComponent ;
                 rdfs:comment "Particle sizes are usually between 5 and 100 microns in size, and can be made from a variety of materials, such as metals, ceramics, polymers, and composites. The exact particle size distribution is an important process parameter and mist be tailored to the specific thermal spray process, the type of material, and the desired outcome/intended application."@en ;
                 rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
                 rdfs:seeAlso "N. Sanpo, J. Wang, C.C. Berndt (2013), Feedstock Material Considerations for Thermal Spray, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                 <http://www.w3.org/2004/02/skos/core#altLabel> "Feedstock"@en ,
                                                                "Powder"@en ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder Feedstock"@en ;
                 :elucidation "Powder feedstock is a material in powder form used produce a coating on a substrate by feeding into a thermal spray torch"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PowderFeedstockPerLayer
:PowderFeedstockPerLayer rdf:type owl:Class ;
                         rdfs:subClassOf :ThermalSprayingProcessProperty ;
                         <http://www.w3.org/2004/02/skos/core#prefLabel> "Powder Feedstock Per Layer"@en ;
                         :elucidation "The mass of powder feedstock sprayed per unit of surface area for each deposited layer."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PreHeating
:PreHeating rdf:type owl:Class ;
            rdfs:subClassOf :ThermalSprayingStage ;
            rdfs:comment """Pre-heating can be achieved either by using a separate heating system or, more frequently, by performing one or more passes of the torch onto the substrate without powder feed to increase the substrate temperature using the heat of the gas jet itself.
Pre-heating serves multiple purposes: it removed adsorbates and condensates (e.g. moisture, volatile organic compounds, etc.); it improves the wettability between the deposited material and the substrate; it prevents excessive temperature gradients across the coating/substrate system during the thermal spray process, which might otherwise result in transverse cracking of the coating due to excessive tensile stresses accumulated in its outer layers."""@en ;
            rdfs:seeAlso "J. Knapp, D. Lemen (2013), Precoating Operations, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Heating"@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Pre-Heating"@en ;
            :elucidation "Pre-heating is a sub-process of thermal spray whereby the temperature of the substrate is increased above room temperature shortly before deposition so that the substrate temperature is higher than room temperature when deposition begins."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Pressure
:Pressure rdf:type owl:Class ;
          rdfs:subClassOf hume:Property ;
          rdfs:isDefinedBy "ISO 80000-4:2019" ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Pressure"@en ;
          :elucidation "Quotient of the component of a force normal to a surface and its area"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PressurelessFeeder
:PressurelessFeeder rdf:type owl:Class ;
                    rdfs:subClassOf :PowderFeeder ;
                    owl:disjointWith :PressurizedFeeder ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Pressureless Feeder"@en ;
                    :elucidation "A powder feeder whose hopper operates at or near ambient pressure, suitable for injecting powder into a region at or below ambient pressure (e.g. downstream injection in low pressure cold spraying)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#PressurizedFeeder
:PressurizedFeeder rdf:type owl:Class ;
                   rdfs:subClassOf :PowderFeeder ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Pressurized Feeder"@en ;
                   :elucidation "A powder feeder whose hopper is pressurised with the carrier gas, so that the powder can be injected into a region of the torch above ambient pressure (e.g. in HVOF, HVAF or high pressure cold spraying)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ProcessMonitoring
:ProcessMonitoring rdf:type owl:Class ;
                   rdfs:subClassOf :ThermalSprayingSubProcess ;
                   rdfs:comment """Process monitoring includes both parameters directly measured by the control unit, and measures from additional sensors such as pyrometers/thermocameras for substrate temperature, in-flight process diagnostics for particle velocities/temperatures, etc.
These can be or not be integrated into a single monitoring system."""@en ;
                   rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                   <http://www.w3.org/2004/02/skos/core#altLabel> "Process Control"@en ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Process Monitoring"@en ;
                   :elucidation "Measuring and controlling key parameters of the thermal spray process in real-time, such as gas flow rates, powder feed rate, substrate temperature, robot movements, etc."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ProcessTimePerLayer
:ProcessTimePerLayer rdf:type owl:Class ;
                     rdfs:subClassOf :ThermalSprayingProcessProperty ;
                     rdfs:comment "Estimated time spent per unit of surface (expressed in cm²) for each layer deposited on the sample."@en ;
                     <http://www.w3.org/2004/02/skos/core#prefLabel> "Process Time Per Layer"@en ;
                     :elucidation "The estimated time spent per unit of surface area (expressed in cm²) for each layer deposited on the sample."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Pycnometer
:Pycnometer rdf:type owl:Class ;
            rdfs:subClassOf :CharacterisationDevice ;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/Gas_pycnometer> ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Pycnometer"@en ;
            :elucidation "A laboratory device used for measuring the density of solids employing some method of gas displacement and the volume:pressure relationship known as Boyle's law."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Pycnometry
:Pycnometry rdf:type owl:Class ;
            rdfs:subClassOf hume:Characterisation ;
            rdfs:seeAlso <https://en.wikipedia.org/wiki/Gas_pycnometer> ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Pycnometry"@en ;
            :elucidation "A characterisation methodology for measuring the density (or, more accurately, the volume) of solids."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Pyrometer
:Pyrometer rdf:type owl:Class ;
           rdfs:subClassOf :CharacterisationDevice ;
           rdfs:seeAlso <https://en.wikipedia.org/wiki/Pyrometer> ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Pyrometer"@en ;
           :elucidation "A type of remote sensing thermometer used to measure the temperature of distant objects."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Pyrometry
:Pyrometry rdf:type owl:Class ;
           rdfs:subClassOf hume:Characterisation ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Pyrometry"@en ;
           :elucidation "A characterisation technique for the non-contact measurement of the temperature of a surface from the thermal radiation it emits."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ResidualStress
:ResidualStress rdf:type owl:Class ;
                rdfs:subClassOf hume:Property ;
                rdfs:isDefinedBy "EN 15305:2018 - Residual stress measurement by XRD" ;
                rdfs:seeAlso "NPL Good Practice Guide 143: Residual stress measurement by FIB+DIC" ,
                             """V. Hauk, Structural and Residual Stress Analysis by Nondestructive Methods. Evaluation - Application - Assessment, Elsevier, 1997
https://doi.org/10.1016/B978-0-444-82476-9.X5000-2""" ;
                <http://www.w3.org/2004/02/skos/core#prefLabel> "Residual Stress"@en ;
                :elucidation """A self-equilibrated system of stresses (with resulting strains) existing in a part in the absence of any externally applied action. These are usually the consequence of technological processes carried out on a part, such as machining; thermal, thermochemical or mechanical treatments; coating deposition; etc.
Residual stresses can be measured non-destructively by X-ray diffraction or (less frequently) neutron diffraction, Raman spectroscopy, photoluminescence piezospectroscopy, or they can be measured destructively by hole-drilling.
Micro-scale measurements of residual stresses  are carried out by Focused Ion Beam (FIB) milling coupled with Digital Image Correlation (DIC)."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#RobotManipulator
:RobotManipulator rdf:type owl:Class ;
                  rdfs:subClassOf :Manipulator ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Robot Manipulator"@en ;
                  :elucidation "A manipulator consisting of an industrial robot arm (typically six-axis articulated) that moves the thermal spray torch along a programmed toolpath."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Roughening
:Roughening rdf:type owl:Class ;
            rdfs:subClassOf :SubstratePreparation ;
            rdfs:comment "The substrate roughening in most cases is achieved by grit blasting: a compressed air stream containing abrasive particles is directed, through a nozzle, toward the part to be treated. It is also possible to use water jets with pressures, or to machine with suitably profiled tools (e.g. dove-tail profiles). Grit blasting or water jet roughening also induces compressive stress in the first tenths of mm below the substrate-roughened surface."@en ;
            rdfs:isDefinedBy "EN 13507:2018: Thermal Spraying - Pre-treatment of surfaces of metallic parts and components for thermal spraying." ,
                             "J. Knapp, D. Lemen (2013), Precoating Operations, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
            rdfs:seeAlso "Anon. (2013), Introduction to Coating Design and Processing, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "SandBlasting"@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Roughening"@en ;
            :elucidation "Roughening the surface to provide asperities or irregularities to enhance coating adhesion and provide a larger effective surface."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Roughness
:Roughness rdf:type owl:Class ;
           rdfs:subClassOf :CharacterisationProperty ;
           rdfs:isDefinedBy "ISO 21920-2:2021 (profile surface texture)" ,
                            "ISO 25178-2:2021 (areal surface texture)" ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Roughness"@en ;
           :elucidation """Deviation of the detected profile/surface of an object (mechanical/electromagnetic/auxiliary profile/surface, depending on whether it is detected through mechanical interaction, electromagnetic interactions including optical methods, or other methods including atomic force microscopy/scanning tunnelling microscopy) from the reference line/surface after removal of (1) the smallest lateral scale components caused by noise in the acquisition system, (2) the macro-scale form, by suitable fitting e.g. to polynomial or spline functions, and (3) the large-scale lateral component (waviness) with a suitable filtering operation (e.g. Gaussian or robust Gaussian filters).
The roughness of a profile/surface can be conveyed by calculating one or more of a series of scalar parameters on the basis of a data matrix containing the complete roughness profile/surface."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SAESteelGrade
:SAESteelGrade rdf:type owl:Class ;
               rdfs:subClassOf hume:Property .


###  https://www.cobrain-project.eu/ontology/cobrain#Sample
:Sample rdf:type owl:Class ;
        rdfs:subClassOf hume:Object ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :isSampleOf ;
                          owl:someValuesFrom hume:Object
                        ] ;
        <http://www.w3.org/2004/02/skos/core#prefLabel> "Sample"@en ;
        :elucidation "An object taken from, or prepared to be representative of, a larger object or material in order to be analysed or tested (e.g. a coated coupon cut for characterisation)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SingleComponentComposition
:SingleComponentComposition rdf:type owl:Class ;
                            rdfs:subClassOf :ChemicalComposition ;
                            rdfs:isDefinedBy <https://w3id.org/emmo#EMMO_172e2c96_180b_40f8_a3e7_b624471f40c2> ;
                            <http://www.w3.org/2004/02/skos/core#prefLabel> "Single Component Composition"@en ;
                            :elucidation "A chemical composition expressing the amount (fraction) of one single constituent, i.e. a chemical element or compound, in a material."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SinglePhaseData
:SinglePhaseData rdf:type owl:Class ;
                 rdfs:subClassOf :PhaseComposition ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Single Phase Data"@en ;
                 :elucidation "A phase composition datum referring to one single phase of a sample, reporting its identity (e.g. crystal structure) and its relative amount."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SkeletalDensity
:SkeletalDensity rdf:type owl:Class ;
                 rdfs:subClassOf :Density ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Skeletal Density"@en ;
                 :elucidation "The density calculated from a volume measured using a gas pycnometer."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SpecificWearRate
:SpecificWearRate rdf:type owl:Class ;
                  rdfs:subClassOf :WearRate ;
                  rdfs:seeAlso """ASTM G99-17: Pin-on-Disc Sliding Test
ASTM G133-05(2016): Linearly Reciprocating Ball-on-Flat Sliding Test
ASTM G77-17: Block-on-Ring Sliding Test
ASTM G65-16(2021): Dry Sand/Rubber Wheel Abrasion Test
ASTM D4060-19: Taber Abrasion Test""" ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Specific Wear Rate"@en ;
                  :elucidation """The specific wear rate is a measure of the loss of material from a surface due to mechanical wear. It represents the specific rate (i.e. rate per unit load) at which a material loses mass when subjected to wear.
It can be measured for sliding, rolling/sliding, and abrasive wear processes."""@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SprayJet
:SprayJet rdf:type owl:Class ;
          rdfs:subClassOf :ThermalSprayingComponent ;
          rdfs:comment """The definition is taken from ISO 14917:2017: Thermal Spraying - Terminology, classification.
The characteristics of the particles in the spray jet, i.e. their velocity and their temperature, depend on the process parameters, the thermophysical properties of the particles themselves and their size distribution. The velocity and temperature of the particles, on the other hand, are the key features that determine the properties of the coating (porosity, adhesive and cohesive strength, etc.)."""@en ;
          rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Particle Jet"@en ,
                                                         "Particle Stream"@en ,
                                                         "Spray Stream"@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Spray Jet"@en ;
          :elucidation "The stream of particles emerging from the thermal spray torch."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SprayTorch
:SprayTorch rdf:type owl:Class ;
            rdfs:subClassOf hume:Device ;
            rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
            rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
            <http://www.w3.org/2004/02/skos/core#altLabel> "Gun"@en ,
                                                           "Spraying Gun"@en ,
                                                           "Torch"@en ;
            <http://www.w3.org/2004/02/skos/core#prefLabel> "Spray Torch"@en ;
            :elucidation "A device that projects a stream of feedstock particles towards a substrate to form a coating by means of a gas jet; in thermal spray torches the feedstock is also heated."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SprayedMass
:SprayedMass rdf:type owl:Class ;
             rdfs:subClassOf :ThermalSprayingProcessProperty ,
                             :Weight ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Sprayed Mass"@en ;
             :elucidation "The mass of powder sprayed onto a single substrate plate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SprayingEfficiency
:SprayingEfficiency rdf:type owl:Class ;
                    rdfs:subClassOf :ThermalSprayingProcessProperty ;
                    <http://www.w3.org/2004/02/skos/core#altLabel> "Deposition Efficiency"@en ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Spraying Efficiency"@en ;
                    :elucidation "The ratio between the mass gain of a plate after coating and the calculated mass of powder sprayed onto a single substrate plate"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Stabilization
:Stabilization rdf:type owl:Class ;
               rdfs:subClassOf :ThermalSprayingStage ;
               rdfs:comment "Powder feeders usually take a brief time, from some tens of seconds to a few minutes, to deliver a constant feed rate upon first startup. The powder feeding must be allowed to stabilize before the torch is moved onto the substrate to avoid irregularities and poor deposit quality which would happen if the feed rate is not constant. The stabilization stage also allows to prevent issues that might arise from feeder malfunction, as this would be detected during the stabilization period and the substrate would not be compromised by an irregular deposition from a malfunctioning feeder."@en ;
               <http://www.w3.org/2004/02/skos/core#prefLabel> "Stabilization"@en ;
               :elucidation "Stabilization is a sub-process of thermal spray during which the powder feed rate is made to stabilize while the torch is not depositing material onto the substrate"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Standoff
:Standoff rdf:type owl:Class ;
          rdfs:subClassOf :ThermalSprayingProcessProperty ;
          <http://www.w3.org/2004/02/skos/core#altLabel> "Spray Distance"@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Stand-Off"@en ;
          :elucidation "The torch-substrate stand-off distance."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Steel
:Steel rdf:type owl:Class ;
       rdfs:subClassOf :Alloy ;
       <http://www.w3.org/2004/02/skos/core#prefLabel> "Steel"@en ;
       :elucidation "An alloy of iron and carbon (typically below about 2 wt.% C), usually containing further alloying elements such as Cr, Ni, Mn or Mo to tailor its properties."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Stellite
:Stellite rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty :materialNickname ;
                                owl:hasValue "Stellite"
                              ] ;
          rdfs:subClassOf :Alloy ;
          <http://purl.org/dc/terms/source> "Industrial Reference"@en ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Stellite"@en ;
          :elucidation "A family of cobalt-chromium based alloys, often containing tungsten or molybdenum and carbon, designed for wear and corrosion resistance; Stellite is a trade name."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Substrate
:Substrate rdf:type owl:Class ;
           rdfs:subClassOf :ThermalSprayingComponent ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty hume:isComponentOf ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :CoatedSubstrate
                           ] ;
           rdfs:comment "Definition adapted from ISO 14917:2017: Thermal Spraying - Terminology, classification."@en ;
           rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "Plate"@en ,
                                                          "Workpiece"@en ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Substrate"@en ;
           :elucidation "The object to be coated (entirely or in part) in a thermal spray process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SubstrateCoolingSystem
:SubstrateCoolingSystem rdf:type owl:Class ;
                        rdfs:subClassOf :CoolingSystem ;
                        rdfs:comment """Compressed air is the most typical coolant, but CO2, liquid nitrogen, or even liquid Ar can also be used in special cases.
The system can be stationary, i.e. fixed nozzles deliver the cooling jet to the substrate surface, and/or movable, i.e. nozzles are installed on the manipulator and move together with the thermal spray torch to cool the substrate surface immediately before and/or after the passage of the thermal spray jet.
In addition to cooling, the jet also serves the purpose of limiting the amount of overspray particles attaching to the surface of the growing deposit layer."""@en ;
                        <http://www.w3.org/2004/02/skos/core#altLabel> "Cooling Jets"@en ;
                        <http://www.w3.org/2004/02/skos/core#prefLabel> "Substrate Cooling System"@en ;
                        :elucidation "A system that delivers a stream of coolant to the substrate surface"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SubstratePreparation
:SubstratePreparation rdf:type owl:Class ;
                      rdfs:subClassOf :ThermalSprayingRelatedProcess ;
                      owl:hasKey ( :preparationID
                                 ) ;
                      rdfs:comment """The sequence of operations during substrate preparation can vary.
Cleaning can be done before and/or after roughening, the latter also exerting a cleaning action. Masking is optional and not necessary in every case, and it can be done before or after roughening, before or after tooling, or the tool itself can include a shadow mask."""@en ;
                      rdfs:isDefinedBy "EN 13507:2018: Thermal Spraying - Pre-treatment of surfaces of metallic parts and components for thermal spraying" ;
                      rdfs:seeAlso "Fauchais, Pierre L.; Heberlein, Joachim VR; Boulos, Maher I. Thermal spray fundamentals: from powder to part. Springer Science & Business Media, 2014." ,
                                   "J. Knapp, D. Lemen (2013), Precoating Operations, in: R.C. Tucker jr. (Ed.), ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Substrate Preparation"@en ;
                      :elucidation "The purpose of substrate preparation is to allow deposition on selected substrate areas and ensure adequate adhesion of the sprayed material. This process comprises the sub-processes of cleaning, roughening, masking, and tooling."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SupplySystem
:SupplySystem rdf:type owl:Class ;
              rdfs:subClassOf hume:System ;
              <http://www.w3.org/2004/02/skos/core#prefLabel> "Supply System"@en ;
              :elucidation "A system that delivers a consumable (e.g. process gases, liquid fuel or powder feedstock) to a device in a controlled way."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Temperature
:Temperature rdf:type owl:Class ;
             rdfs:subClassOf hume:Property ;
             rdfs:seeAlso "ISO 80000-5:2019" ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Temperature"@en ;
             :elucidation "Partial derivative of internal energy of a system with respect to entropy at constant volume and constant number of particles in the system."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#TemperaturePeaks
:TemperaturePeaks rdf:type owl:Class ;
                  rdfs:subClassOf hume:ArrayData ,
                                  :Temperature ,
                                  :ThermalSprayingProcessProperty ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Temperature Peaks"@en ;
                  :elucidation "An array with the temperature peaks of an entity measured during an interval of time."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSpraySystem
:ThermalSpraySystem rdf:type owl:Class ;
                    rdfs:subClassOf hume:System ;
                    <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spray System"@en ;
                    :elucidation "The overall equipment for performing thermal spraying, comprising the spray torch and its supporting systems (e.g. gas, fuel and powder supply, cooling, control unit, manipulator and holding system)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayTorch
:ThermalSprayTorch rdf:type owl:Class ;
                   rdfs:subClassOf :SprayTorch ;
                   rdfs:comment """Definition taken with slight adaptation from ISO 14917:2017: Thermal Spraying - Terminology, classification.
The torch can be operated manually or automatically, and the process parameters, such as the gas flow rates and powder feed rate, can be adjusted to control the properties of the resulting coating.
The combustion-based torch design typically consists of a combustion chamber, a powder injector, and a nozzle. Other types of torches can differ slightly in their main constituents but all encompass a nozzle from which the gas flow emerges."""@en ;
                   rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
                   rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spray Torch"@en ;
                   :elucidation "The unit with which the feedstock is heated to the plastic or molten state, accelerated and projected onto the prepared substrate surface."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSpraying
:ThermalSpraying rdf:type owl:Class ;
                 rdfs:subClassOf :ThermalSprayingRelatedProcess ;
                 rdfs:comment """Thermal spraying is distinguished by cladding processes by the lack of substrate melting during the process.
The feedstock material may be in the form of powder, ceramic rod, wire, or molten materials.
The definition is adapted from ISO 14917:2017"""@en ;
                 rdfs:isDefinedBy "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
                 rdfs:seeAlso "D.E. Crawmer (2013), Thermal Spray Processes, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ,
                              "Hermanek FJ (2001) Thermal spray terminology and company origins. ASM International, Materials Park, OH" ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying"@en ;
                 :elucidation "Thermal spray comprises a group of coating processes in which finely divided materials are heated to a molten, semi-molten or plastic condition and propelled onto solid substrate surface by means of a Thermal Spray Torch, forming a coating."@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :ThermalSpraying ;
   owl:annotatedProperty rdfs:isDefinedBy ;
   owl:annotatedTarget "ISO 14917:2017: Thermal Spraying - Terminology, classification." ;
   rdfs:comment "https://www.iso.org/obp/ui/#iso:std:iso:14917:ed-2:v1:en:term:3.1"^^xsd:anyURI
 ] .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayingComponent
:ThermalSprayingComponent rdf:type owl:Class ;
                          rdfs:subClassOf hume:Component ;
                          <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying System Component"@en ;
                          :elucidation "A component that is part of a thermal spray system or that takes part in a thermal spraying process, such as the substrate, the powder feedstock, the spray jet, the fixture or the control unit."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayingProcessDescription
:ThermalSprayingProcessDescription rdf:type owl:Class ;
                                   rdfs:subClassOf hume:Description ;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying Process Description"@en ;
                                   :elucidation "A description that collects the data characterising a specific thermal spraying process, such as process parameters and measured quantities."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayingProcessProperty
:ThermalSprayingProcessProperty rdf:type owl:Class ;
                                rdfs:subClassOf hume:Property ;
                                <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying Process Property"@en ;
                                :elucidation "A property defined specifically for the description of thermal spraying process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayingRelatedProcess
:ThermalSprayingRelatedProcess rdf:type owl:Class ;
                               rdfs:subClassOf hume:Process ;
                               <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying Related Process"@en ;
                               :elucidation "A process that belongs to the thermal spraying workflow, including thermal spraying itself, its stages and sub-processes, and the preparation of the substrate."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayingStage
:ThermalSprayingStage rdf:type owl:Class ;
                      rdfs:subClassOf :ThermalSprayingRelatedProcess ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty hume:isStageOf ;
                                        owl:someValuesFrom :ThermalSpraying
                                      ] ;
                      <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying Stage"@en ;
                      :elucidation "A temporal part of a thermal spraying process, such as pre-heating, stabilisation or deposition."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#ThermalSprayingSubProcess
:ThermalSprayingSubProcess rdf:type owl:Class ;
                           rdfs:subClassOf :ThermalSprayingRelatedProcess ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty hume:isSubProcessOf ;
                                             owl:someValuesFrom :ThermalSpraying
                                           ] ;
                           <http://www.w3.org/2004/02/skos/core#prefLabel> "Thermal Spraying Sub Process"@en ;
                           :elucidation "A process that runs as part of a thermal spraying process in support of it, such as gas feeding, powder feeding or process monitoring."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Thickness
:Thickness rdf:type owl:Class ;
           rdfs:subClassOf hume:Property ;
           rdfs:isDefinedBy "ISO 80000-3:2019" ;
           <http://www.w3.org/2004/02/skos/core#prefLabel> "Thickness"@en ;
           :elucidation "Minimum length of a straight line segment between two parallel planes enclosing an object"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#TiC-Al0
:TiC-Al0 rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty :materialNickname ;
                               owl:hasValue "TiC-Al0"
                             ] ;
         rdfs:subClassOf :CerMet ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :atComposition ;
                           owl:hasValue "Ti28.7C28.7Cr8.5Fe17Mn10.6Ni6.4"
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :elements ;
                           owl:hasValue "TiC-AlCrFeMnNi"
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :volComposition ;
                           owl:hasValue "TiC60AlCrFeMnNi40"
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :wtComposition ;
                           owl:hasValue "Ti33.7C8.5Cr10.9Fe23.4Mn10.6Ni9.2"
                         ] ;
         <http://purl.org/dc/terms/source> "CoBRAIN CerMet based on Al0"@en ;
         <http://www.w3.org/2004/02/skos/core#altLabel> "Al0(CrFeMnNi)+60TiC"@en ,
                                                        "TiC 49wt% - Cr9.6 Fe20.8 Mn12.8 Ni8.2"@en ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "TiC-Al0"@en ;
         :elucidation "A cermet made of TiC particles in an Al0 (CrFeMnNi) high entropy alloy binder, with nominal composition 60 vol.% TiC and 40 vol.% binder."@en .


