@prefix : <https://www.cobrain-project.eu/ontology/cobrain#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix hume: <https://w3id.org/emmo/hume#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix elite: <https://w3id.org/emmo/elite#> .
@base <https://www.cobrain-project.eu/ontology/cobrain#> .

<https://www.cobrain-project.eu/ontology/cobrain> rdf:type owl:Ontology ;
                                                   owl:versionIRI <https://www.cobrain-project.eu/ontology/cobrain/0.0.1> ;
                                                   owl:imports <https://w3id.org/emmo/0.0.7/elite> ;
                                                   <http://purl.org/dc/terms/contributor> """Alvise Bianchin
Matres scrl
alvise.bianchin@matres.org""" ,
                                                                                          """Giovanni Bolelli
Università degli Studi di Modena e Reggio Emilia
giovanni.bolelli@unimore.it""" ;
                                                   <http://purl.org/dc/terms/creator> """Emanuele Ghedini
Alma Mater Studiorum - Università di Bologna
emanuele.ghedini@unibo.it""" ;
                                                   <http://purl.org/dc/terms/license> """This work is licensed under CC BY 4.0
https://creativecommons.org/licenses/by/4.0/""" ;
                                                   rdfs:comment """Work performed in the framework of CoBRAIN Project
Funded under European Commission Horizon Europe: Digital, Industry and Space
Grant agreement ID: 101092211
https://doi.org/10.3030/101092211"""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
<http://www.w3.org/2004/02/skos/core#altLabel> rdf:type owl:AnnotationProperty ;
                                               rdfs:subPropertyOf rdfs:label .


###  http://www.w3.org/2004/02/skos/core#example
<http://www.w3.org/2004/02/skos/core#example> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty ;
                                                rdfs:subPropertyOf rdfs:label .


###  https://www.cobrain-project.eu/ontology/cobrain#elucidation
:elucidation rdf:type owl:AnnotationProperty ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "elucidation"@en ;
             rdfs:subPropertyOf rdfs:comment .


###  https://www.cobrain-project.eu/ontology/cobrain#productionInformation
:productionInformation rdf:type owl:AnnotationProperty ;
                       <http://www.w3.org/2004/02/skos/core#prefLabel> "production information"@en ;
                       rdfs:subPropertyOf rdfs:comment .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/emmo/hume#isRemovedfrom
hume:isRemovedfrom rdf:type owl:ObjectProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#hasMeasurer
:hasMeasurer rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf hume:affects ,
                                hume:hasInterpreter ;
             owl:inverseOf :isMeasurerFor .


###  https://www.cobrain-project.eu/ontology/cobrain#hasSample
:hasSample rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf hume:hasInput ,
                              hume:hasReferent ;
           owl:inverseOf :isSampleFor ;
           rdfs:domain hume:Measurement ;
           rdfs:range :Sample .


###  https://www.cobrain-project.eu/ontology/cobrain#isMeasuredBy
:isMeasuredBy rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf hume:isInterpretedBy .


###  https://www.cobrain-project.eu/ontology/cobrain#isMeasurerFor
:isMeasurerFor rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf hume:isInterpreterFor ,
                                  hume:participatesTo ;
               rdfs:domain hume:Measurer ;
               rdfs:range hume:Measurement .


###  https://www.cobrain-project.eu/ontology/cobrain#isSampleFor
:isSampleFor rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf hume:isInputOf ,
                                hume:isReferentFor ;
             rdfs:range hume:Characterisation .


###  https://www.cobrain-project.eu/ontology/cobrain#isSampleOf
:isSampleOf rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf hume:isRemovedfrom ;
            rdfs:domain :Sample ;
            rdfs:range hume:Object .


###  https://www.cobrain-project.eu/ontology/cobrain#propertyProvidedBy
:propertyProvidedBy rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf hume:isOutputOf ,
                                       hume:isSignFor ;
                    owl:inverseOf :providesProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#providesProperty
:providesProperty rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf hume:hasOutput ,
                                     hume:hasSign ;
                  rdfs:domain hume:Measurement ;
                  rdfs:range hume:Property .


#################################################################
#    Data properties
#################################################################

###  https://www.cobrain-project.eu/ontology/cobrain#CGSData
:CGSData rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#HVAFData
:HVAFData rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :HVAF ;
          :elucidation "The super property for all data properties refering to HVAF process specific data."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#JCPDSCode
:JCPDSCode rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           :elucidation "A standard reference number assigned to a specific crystalline material's X-ray diffraction (XRD) pattern"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#MBN_ID
:MBN_ID rdf:type owl:DatatypeProperty ;
        rdfs:comment "The data properties includes uniivocal and non-univocal IDs."@en ;
        :elucidation "Data properties for the MBN ID system."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#SAESteelGrade
:SAESteelGrade rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :materialName ;
               rdfs:domain :Steel ;
               rdfs:range xsd:string .


###  https://www.cobrain-project.eu/ontology/cobrain#SOPFile
:SOPFile rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:range xsd:anyURI .


###  https://www.cobrain-project.eu/ontology/cobrain#absoluteError
:absoluteError rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               :elucidation "The absolute error of a data value. It shares the same refrence unit of the value."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#atComposition
:atComposition rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :composition .


###  https://www.cobrain-project.eu/ontology/cobrain#blastingMedia
:blastingMedia rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :HVAFData ;
               :elucidation "The code for the blasting media used in blasting process for substrate preparation."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#composition
:composition rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             :elucidation "A string that provides informations about the composition of a material."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#deliveryDate
:deliveryDate rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#depositionDate
:depositionDate rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :executionDate ;
                :elucidation "The date and time of execution of a deposition process"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#elements
:elements rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :composition .


###  https://www.cobrain-project.eu/ontology/cobrain#executionDate
:executionDate rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain hume:Process ;
               rdfs:range xsd:dateTime ;
               :elucidation "A reference date and time for a process execution."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#gunType
:gunType rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :CGSData .


###  https://www.cobrain-project.eu/ontology/cobrain#indenterID
:indenterID rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :nonUniqueID .


###  https://www.cobrain-project.eu/ontology/cobrain#indenterLoad
:indenterLoad rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :microHardnessData ;
              rdfs:domain :Indentation ;
              :elucidation "The load of the indenter during hardness measurement, expressed in grams [g]"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#injectorType
:injectorType rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :HVAFData ;
              :elucidation "The code for the HVAF injector type."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#inletGas
:inletGas rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :CGSData .


###  https://www.cobrain-project.eu/ontology/cobrain#instrumentID
:instrumentID rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :nonUniqueID ;
              :elucidation "An ID associated to an instrument (non unique)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#labCode
:labCode rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :MBN_ID ,
                            :uniqueID ;
         rdf:type owl:FunctionalProperty ;
         rdfs:domain :CoatedSubstrate ;
         rdfs:range xsd:string ;
         rdfs:comment """Used as key for:
Coated Substrate"""@en ;
         :elucidation "MBN ID code for laboratory samples"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#lotNumber
:lotNumber rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :MBN_ID ,
                              :uniqueID ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain hume:Material ,
                       :Powder ;
           rdfs:range xsd:string ;
           rdfs:comment "A lot number univocally identifies a material batch that can be used by different processes. Since the EMMO represents 4D entities, the domain of this data property is a material entity extending in space and time, including the ramifications when portions of the batch goes through different locations."@en ,
                        """Used as key for:
Powder"""@en ;
           <http://www.w3.org/2004/02/skos/core#altLabel> "hasBatchReference"@en ;
           :elucidation "MBN ID code for material batches"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#materialName
:materialName rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain hume:Material ;
              :elucidation "A name that can be used to identify a material, not necessarily well-formed."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#materialNickname
:materialNickname rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf :materialName ;
                  :elucidation "A name used to univocally identify a material type within the CoBRAIN project."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#microHardnessData
:microHardnessData rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#modelType
:modelType rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           :elucidation "The model of a device."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#nominalComposition
:nominalComposition rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf :composition ;
                    <http://www.w3.org/2004/02/skos/core#example> "Al0(Cr20)Mn25Fe40Ni15)86+60vol.%TiC"@en ;
                    :elucidation "An string that provide information about the molar composition of a material in free format (i.e., without a specific syntactic definition)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#nonUniqueID
:nonUniqueID rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:comment """A non-unique ID is in practical terms suggests that all entities with the same ID value may belong to a more general class that is not explicitly defined in the ontology for some reason (e.g., keep a simple taxonomy).
For example, if two individuals having a non unique ID data property called :colorID both with value \"red\"."""@en ;
             :elucidation "An ID whose value is potentially shared by more than one individuals, used to identify individuals sharing a common trait. Cannot be used as IRI."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#nozzleType
:nozzleType rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf :CGSData .


###  https://www.cobrain-project.eu/ontology/cobrain#numberOfDepositionLayers
:numberOfDepositionLayers rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:comment "It is used for both deoposition and blasting processes, since the blasting and deposition devices are the same."@en ;
                          :elucidation "The number of passes performed by the torch following the deposition program on the set of substrates mounted on the equipment."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#phaseName
:phaseName rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#pinOnDiscData
:pinOnDiscData rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#podDistance
:podDistance rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf :pinOnDiscData ;
             :elucidation "The total sliding distance traveled by the pin against the rotating disc during the test, measured in meters (m)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#podLoad
:podLoad rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf :pinOnDiscData ;
         :elucidation "The normal force (applied weight/load) pressing the stationary pin onto the surface of the rotating disc, measured in Newtons (N)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#podPinDiameter
:podPinDiameter rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :pinOnDiscData ;
                :elucidation "The nominal diameter of the cylindrical pin (or the diameter of the spherical ball if a ball-on-disc configuration is used), expressed in millimeters (mm)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#podPinMaterial
:podPinMaterial rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :pinOnDiscData ;
                :elucidation "A literal string or controlled vocabulary identifier specifying the composition, alloy, or coating of the pin specimen (e.g., \"AISI 52100 steel\", \"Alumina\")."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#podSpeed
:podSpeed rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :pinOnDiscData ;
          :elucidation "The relative linear sliding velocity at the contact interface (in cm/s)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#podTemperature
:podTemperature rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :pinOnDiscData ;
                :elucidation "The ambient or controlled environmental temperature at which the tribological test is conducted, typically expressed in degrees Celsius (°C)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#podTrackRadius
:podTrackRadius rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :pinOnDiscData ;
                :elucidation "The radial distance from the center of rotation of the disc to the center of the pin's contact path (wear track), recorded in millimeters (mm)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#preparationID
:preparationID rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :nonUniqueID ;
               rdfs:domain :SubstratePreparation ;
               rdfs:comment """Used as key for:
GritBlasting"""@en ;
               :elucidation "A non unique ID code used within CoBRAIN project to identify substrate preparation process."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#primaryNozzleType
:primaryNozzleType rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf :HVAFData ;
                   :elucidation "The code for the HVAFprimary nozzle type."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#processID
:processID rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf :nonUniqueID ;
           rdfs:domain :ThermalSpraying ;
           rdfs:range xsd:string ;
           rdfs:comment """Used as key for:
CGS
HVOF
HVAF"""@en ;
           :elucidation "A non unique ID code used within CoBRAIN project to identify thermal spraying processes."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#relativeError
:relativeError rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               :elucidation "The reative error of a data value. It is expressed as percentage %."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#runNumber
:runNumber rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           :elucidation "An integer the specify that the deposition run is a part of a sequence."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#sampleID
:sampleID rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf :nonUniqueID ;
          rdfs:domain :CoatedSubstrate ;
          rdfs:range xsd:string ;
          rdfs:comment "The string provided by this data property is a useful tag for querying several ontological entities related to the same set of operanting conditions such as materials or procedures, used to generate a sample."@en ,
                       """Used as key for:
Coated Substrate"""@en ;
          :elucidation "A non unique ID code used within CoBRAIN project to tag a coated sample."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#secondaryNozzleType
:secondaryNozzleType rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf :HVAFData ;
                     :elucidation "The code for the HVAF secondary nozzle type."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#serialNumber
:serialNumber rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf :uniqueID ;
              rdf:type owl:FunctionalProperty ;
              rdfs:range xsd:string ;
              :elucidation "The serial number of a product (unique in the scope of CoBRAIN)."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#species
:species rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:domain :SingleComponentComposition .


###  https://www.cobrain-project.eu/ontology/cobrain#standardDeviation
:standardDeviation rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain hume:Data ;
                   :elucidation "Given a data value which is an average over a list of values, this data property provides its standard deviation."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#substrateDimensions
:substrateDimensions rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:range xsd:string ;
                     :elucidation "The dimensions of the substrate, not necessarily related to deposition surface."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#surfaceTreatment
:surfaceTreatment rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty .


###  https://www.cobrain-project.eu/ontology/cobrain#uniqueID
:uniqueID rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:comment "An ID that univocally identifies an individual across different types in the CoBRAIN framework. This ID can be used as IRI for entities."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#volComposition
:volComposition rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf :composition .


###  https://www.cobrain-project.eu/ontology/cobrain#wtComposition
:wtComposition rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf :composition ;
               rdfs:comment "Weight fraction of a constituent type (e.g., species, substance)"@en .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/emmo/hume#Device
hume:Device <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/emmo#EMMO_494b372c_cfdf_47d3_a4de_5e037c540de8> .


###  https://www.cobrain-project.eu/ontology/cobrain#Abrasimeter
:Abrasimeter rdf:type owl:Class ;
             rdfs:subClassOf :CharacterisationDevice ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Abrasimeter"@en ;
             :elucidation "A characterisation device used to perform abrasive wear tests, in which a specimen is worn against an abrasive medium (e.g. abrasive wheel, abrasive slurry or abrasive paper) under controlled load and sliding distance."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#AbrasiveWearTest
:AbrasiveWearTest rdf:type owl:Class ;
                  rdfs:subClassOf :WearTest ;
                  <http://www.w3.org/2004/02/skos/core#prefLabel> "Abrasive Wear Test"@en ;
                  :elucidation "A wear test in which the surface of the specimen is worn by hard particles or by hard asperities of a counterface (e.g. dry sand/rubber wheel test, ASTM G65), and the wear resistance is evaluated from the resulting mass or volume loss."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#AbrasiveWearTestingProperty
:AbrasiveWearTestingProperty rdf:type owl:Class ;
                             rdfs:subClassOf hume:Property ;
                             <http://www.w3.org/2004/02/skos/core#prefLabel> "Abrasive Wear Testing Property"@en ;
                             :elucidation "A property describing the conditions or the results of an abrasive wear test."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Adhesion
:Adhesion rdf:type owl:Class ;
          rdfs:subClassOf hume:Property ;
          rdfs:seeAlso "ASTM C633-13 (2017)" ,
                       """ISO 4618:2023, 3.7
phenomenon of attachment at the interface between a solid surface and another material caused by molecular forces""" ;
          <http://www.w3.org/2004/02/skos/core#prefLabel> "Adhesion"@en ;
          :elucidation """(ASTM D907) \"The state in which two surfaces are held together by interphase forces which may consist of chemical forces or interlocking action, or both\"
Tensile adhesion is obtained by a pull-off test."""@en .

[ rdf:type owl:Axiom ;
   owl:annotatedSource :Adhesion ;
   owl:annotatedProperty rdfs:seeAlso ;
   owl:annotatedTarget """ISO 4618:2023, 3.7
phenomenon of attachment at the interface between a solid surface and another material caused by molecular forces""" ;
   rdfs:isDefinedBy "https://www.iso.org/obp/ui/#iso:std:iso:4618:ed-3:v1:en:term:3.7"
 ] .


###  https://www.cobrain-project.eu/ontology/cobrain#AirFeed
:AirFeed rdf:type owl:Class ;
         rdfs:subClassOf :GasFeedDescription ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty hume:hasDatum ;
                           owl:someValuesFrom :AirFlowRate
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty hume:hasDatum ;
                           owl:someValuesFrom :AirPressure
                         ] ;
         <http://www.w3.org/2004/02/skos/core#prefLabel> "Air Feed"@en ;
         :elucidation "A gas feed description of the compressed air fed to a device or process, characterised by its flow rate and pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#AirFlowRate
:AirFlowRate rdf:type owl:Class ;
             rdfs:subClassOf :FlowRate ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Air Flow Rate"@en ;
             :elucidation "The flow rate of compressed air (in flow meter reading, FMR)"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#AirPressure
:AirPressure rdf:type owl:Class ;
             rdfs:subClassOf :Pressure ;
             <http://www.w3.org/2004/02/skos/core#prefLabel> "Air Pressure"@en ;
             :elucidation "The air pressure."@en .


###  https://www.cobrain-project.eu/ontology/cobrain#AirSupplySystem
:AirSupplySystem rdf:type owl:Class ;
                 rdfs:subClassOf :GasSupplySystem ;
                 rdfs:comment "This system is designed to provide a consistent, safe, and high-quality supply of compressed air to the thermal spray system. The system can be pressure- and/or volume flow-controlled. Compressed air is usually produced on-site with a suitably sized compressor."@en ;
                 rdfs:seeAlso "D.E. Crawmer (2013), Process Control and Control Equipment, in: R.C. Tucker jr. (Ed.),ASM Handbook Vol. 5A: Thermal Spray Technology, ASM International, Materials Park, OH, USA." ;
                 <http://www.w3.org/2004/02/skos/core#prefLabel> "Air Supply System"@en ;
                 :elucidation "The air supply system feeds and regulates the flow of air to the thermal spray system, including as process gas, as torch cooling medium, and as substrate cooling medium"@en .


###  https://www.cobrain-project.eu/ontology/cobrain#Al0
:Al0 rdf:type owl:Class ;
     owl:equivalentClass [ rdf:type owl:Restriction ;
                           owl:onProperty :materialNickname ;
                           owl:hasValue "Al0"
                         ] ;
     rdfs:subClassOf :HighEntropyAlloy ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :atComposition ;
                       owl:hasValue "Cr20Fe40Mn25Ni15"
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :elements ;
                       owl:hasValue "CrFeMnNi"
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :volComposition ;
                       owl:hasValue "CrFeMnNi100"
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :wtComposition ;
                       owl:hasValue "Cr18.8Fe40.4Mn25Ni15.9"
                     ] ;
     <http://purl.org/dc/terms/source> "Literature"@en ;
     <http://www.w3.org/2004/02/skos/core#altLabel> "Al0(Cr20Fe40Mn25Ni15)100"@en ,
                                                    "Al0(CrFeMnNi)"@en ;
     <http://www.w3.org/2004/02/skos/core#prefLabel> "Al0"@en ;
     :elucidation "A CrFeMnNi high entropy alloy without aluminium, used as the base of the Al-containing series, with nominal composition Cr20Fe40Mn25Ni15 (at.%)."@en .


